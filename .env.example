# ===== LLM: Ollama (required) =====
# Mac 本地 Ollama 默认地址
OLLAMA_HOST=http://localhost:11434
# 使用的模型名（需已通过 ollama pull 下载）
OLLAMA_MODEL=qwen3:latest
# 可选：备用 Ollama 实例（高负载时 fallback）
# OLLAMA_FALLBACK_HOST=http://localhost:11434
# OLLAMA_FALLBACK_MODEL=llama3.2:latest

# ===== Server =====
PORT=3000

# ===== Chain: Base（可选，不填则使用 Mock）=====
# BASE_RPC_URL=https://mainnet.base.org
# BASE_PRIVATE_KEY=0x...
# NFT_CONTRACT_ADDRESS=0x...

# ===== Anthropic API（可选，当前版本未使用）=====
# ANTHROPIC_API_KEY=sk-ant-...
